#!/bin/bash

# Disable automatic expansion of "!<cmd>" in interactive sessions
set +o histexpand

# Make some commands verbose
for cmd in cp mv rm chmod rename; do
    alias $cmd="$cmd -v"
done

# Add default args to some commands
alias grep="grep -I --ignore-case --exclude-dir=.git --exclude-dir=.svn"
alias tree="tree --charset=ascii"
alias dc=docker-compose

# Yeah...
alias vi=nvim
alias vim=nvim
alias voim=nvim
export EDITOR=nvim

alias ding='sh -c "afplay /System/Library/Sounds/Hero.aiff &"'
alias womp='sh -c "afplay /System/Library/Sounds/Funk.aiff &"'

function mk() {
  make "$@" && ding || womp
}

export FZF_DEFAULT_COMMAND='ag -l'

alias ag='ag --width=200'

export LESS="--RAW-CONTROL-CHARS --jump-target=10 --ignore-case"

# Add existing directories to PATH without introducing duplicates.
function path_prepend() {
  [[ -d $1 ]] || return
  case ":$PATH:" in
    *":$1:"*) ;;
    *) export PATH="$1${PATH:+:$PATH}" ;;
  esac
}

# Context
alias h=hostname
alias parents='pstree --ascii --show-parents --show-pids --arguments --highlight-pid=$$ $$ | grep -e "" -e "${SHELL##*/}"'
alias path=$'echo $PATH | tr : "\n"'
function cd() { builtin cd "$@" && ls; }

# Highlighting
# Pasting snippets from workflowy, sometimes I encounter spaces replaced with
# non-breaking spaces. This highlights them in files or from stdin.
alias nbsp="GREP_COLOR='44' grep -I $'\u00A0'"
# Highlight DOS newlines
alias crlf="GREP_COLOR='44' grep -IU $'\r\n'"

# Text processing / formatting
alias cuts="cut -d ' '"

# Git aliases
alias g=git
alias gst='git status -s; git stash list; git bisect log 2>/dev/null'
alias gd='git diff --ignore-space-change'
alias gdc='git diff --cached --ignore-space-change'
alias gs='git show'
alias gh='git log --oneline --graph --decorate --first-parent -n25'
alias ga='git add'
alias gc='git commit -v'
alias gb='git branch -vv --sort=-committerdate'
alias gsw='gco $(gb | fzf | sed "s/^..//;s/ .*//")'
alias gr='git remote -v'
alias gri='git rebase --interactive'
alias grim='gri origin/main'
alias b='git branch --sort=-committerdate | sed s/..// | fzf'
alias gt='git tag'
alias gcm='git checkout main || git checkout master'
function gco() { git checkout "$@" && gst; }
alias gcp='git cherry-pick'
function gr-() { git checkout "$1" && git rebase -i -; }
alias glf='git ls-files | fzf | tr -d "\n" | pbcopy'
function git-prune-branches() {
  git fetch --all --prune && git branch -v | awk '/\[gone\]/{print $1}' | xargs git branch -D
}
alias gw='git worktree'

# Frequently used directory aliases formerly supplied by Oh My Zsh.
alias cd..='cd ..'
alias d='dirs -v | head -10'
alias l='ls -lah'
alias la='ls -lAh'

alias diff='GIT_DIR=/ git diff'

alias pr='git push -u origin HEAD && command gh pr create --fill --base main'

alias serve='echo http://localhost:5000 && python -m http.server 5000 -d .'

alias dig='grc dig'
alias ping='grc ping'
alias ps='grc ps'
alias lsof='grc lsof'

# jq-structure: https://github.com/jqlang/jq/issues/243#issuecomment-48470943
function jqs() {
  jq -r '[path(..)|map(if type=="number" then "[]" else tostring end)|join(".")|split(".[]")|join("[]")]|unique|map("."+.)|.[]' "$@"
}

# Base command paths. Each entry is prepended, so list lower-priority paths
# first.
_homebrew_root=/opt/homebrew
path_prepend "$_homebrew_root/anaconda3/bin"
path_prepend "$_homebrew_root/sbin"
path_prepend "$_homebrew_root/bin"
path_prepend "$HOME/bin"
unset _homebrew_root

# PNPM
export PNPM_HOME="$HOME/Library/pnpm"
path_prepend "$PNPM_HOME"

# Android
export ANDROID_HOME=$HOME/Library/Android/sdk
export JAVA_HOME=/opt/homebrew/opt/openjdk
path_prepend "$JAVA_HOME/bin"

# Google Cloud SDK
CLOUDSDK=$HOME/google-cloud-sdk
path_prepend "$CLOUDSDK/bin"

# Interactive application commands should take precedence over toolchain paths.
path_prepend "$HOME/.codeium/windsurf/bin"
path_prepend "$HOME/.local/bin"

unset -f path_prepend

alias claude="claude --allow-dangerously-skip-permissions"
